#include <winver.h>
#include "driver_version.h"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION SAMPLEKERNEL_FILE_VERSION
 PRODUCTVERSION SAMPLEKERNEL_FILE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DRV
 FILESUBTYPE VFT2_DRV_SYSTEM
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "SampleKernel1 Kernel Driver"
   VALUE "FileVersion", SAMPLEKERNEL_FILE_VERSION_TEXT
   VALUE "InternalName", "SampleKernel1"
   VALUE "OriginalFilename", "SampleKernel1.sys"
   VALUE "ProductName", "SampleKernel1"
   VALUE "ProductVersion", SAMPLEKERNEL_FILE_VERSION_TEXT
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
