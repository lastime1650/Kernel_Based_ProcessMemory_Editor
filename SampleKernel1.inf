;
; SampleKernel1.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = SampleKernel1.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
SampleKernel1.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%SampleKernel1.DeviceDesc% = SampleKernel1_Device, Root\SampleKernel1 ; TODO: edit hw-id

[SampleKernel1_Device.NT]
CopyFiles = File_Copy

[File_Copy]
SampleKernel1.sys

;-------------- Service installation
[SampleKernel1_Device.NT.Services]
AddService = SampleKernel1,%SPSVCINST_ASSOCSERVICE%, SampleKernel1_Service_Inst

; -------------- SampleKernel1 driver install sections
[SampleKernel1_Service_Inst]
DisplayName    = %SampleKernel1.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\SampleKernel1.sys

[SampleKernel1_Device.NT.Wdf]
KmdfService = SampleKernel1, SampleKernel1_wdfsect

[SampleKernel1_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "SampleKernel1 Installation Disk"
SampleKernel1.DeviceDesc = "SampleKernel1 Device"
SampleKernel1.SVCDESC = "SampleKernel1 Service"
